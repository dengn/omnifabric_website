[Unit]
Description=OmniFabric CloudSigma SSO broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/omnifabric
EnvironmentFile=/etc/omnifabric/cloudsigma-broker.env
ExecStart=/usr/bin/node /var/www/omnifabric/server/node-server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
